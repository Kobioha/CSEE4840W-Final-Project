#include "game.h"
#include "input.h"
#include "render.h"
#include <unistd.h>

int main(void) {
    game_t game;

    game_init(&game);

    while (game.player_hp > 0) {
        uint16_t input = input_read(game.frame);

        game_tick(&game, input);
        render_frame(&game);

        usleep(16666);
    }

    return 0;
}
